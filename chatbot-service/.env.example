# =================================================================
# SUCCESS ACADEMY CHATBOT SERVICE CONFIGURATION (.env)
# =================================================================

# Server Port (Default: 8090)
SERVER_PORT=8090

# Eureka Discovery URL
EUREKA_URI=http://localhost:8761/eureka/

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chatbotdb
DB_USER=root
DB_PASSWORD=Farukh@106

# -----------------------------------------------------------------
# AI PROVIDER CONFIGURATION (Optional - Fallback handles ERP tools)
# -----------------------------------------------------------------
# Supported Providers: openai | openrouter | groq | ollama | fallback
AI_PROVIDER=openai

# OpenAI / OpenRouter / Groq API Key (Leave empty to use deterministic live ERP fallback)
AI_API_KEY=

# Model Name (e.g. gpt-4o-mini, llama-3.1-8b-instant, gemma2:9b)
AI_MODEL=gpt-4o-mini

# API Base URL (Default: https://api.openai.com/v1)
# For Groq: https://api.groq.com/openai/v1
# For OpenRouter: https://openrouter.ai/api/v1
# For Ollama: http://localhost:11434/v1
AI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------
# INTERNAL MICROSERVICE URLS (Defaults to Eureka/local routing)
# -----------------------------------------------------------------
STUDENT_SERVICE_URL=http://localhost:8085
FACULTY_SERVICE_URL=http://localhost:8086
ATTENDANCE_SERVICE_URL=http://localhost:8088
FEE_SERVICE_URL=http://localhost:8087
NOTICE_SERVICE_URL=http://localhost:8081
EVENT_SERVICE_URL=http://localhost:8082
CONTACT_SERVICE_URL=http://localhost:8083
