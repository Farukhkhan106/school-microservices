# =================================================================
# SUCCESS ACADEMY MICROSERVICES ENVIRONMENT CONFIGURATION
# =================================================================

# Database Root Password (for local MySQL container)
DB_ROOT_PASSWORD=change_this_to_a_strong_password

# Database Name (default)
DB_NAME=school_db

# Shared JWT Secret Key (Must be 32+ characters, identical across auth-service and api-gateway)
JWT_SECRET=YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARS_LONG_HERE

# Whitelisted Frontend Origins for CORS (Comma-separated, no trailing slashes)
CORS_ORIGINS=https://success-academy-frontend.vercel.app,http://localhost:3000

# Optional: Email SMTP Configuration (for contact form email alerts)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
